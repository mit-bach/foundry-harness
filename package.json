  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "foundry",
    "grokbot",
    "multi-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mit-bach/foundry-harness.git"
  },
  "homepage": "https://github.com/mit-bach/foundry-harness#readme",
  "bugs": {
    "url": "https://github.com/mit-bach/foundry-harness/issues"
  },
  "files": [
